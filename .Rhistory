OnlyInt <- compR2Int
OnlyInt[!is.na(OnlyInt)] <- NA
compR2Int2  <- matrix(NA, length(meanInterplays), 2)
rownames(compR2Int2) <- names(meanInterplays)
for (i in rownames(tttt)) {
for (j in rownames(tttt)) {
if (!is.na(meanInterplays[paste(i,j,sep="")]) | as.numeric(str_extract(i,"[0-9]+")) == as.numeric(str_extract(j,"[0-9]+"))) {
compR2Int[i,j] <- meanInterplays[paste(i,j,sep="")]
OnlyInt[i,j] <- OnlyInt[j,i] <-  meanInterplays[paste(i,j,sep="")]
if (as.numeric(str_extract(i,"[0-9]+")) != as.numeric(str_extract(j,"[0-9]+"))) {
compR2Int2[paste(i,j,sep=""),1] <-  meanInterplays[paste(i,j,sep="")]
compR2Int2[paste(i,j,sep=""),2] <- compR2Int[j,i]
}
}
}
}
