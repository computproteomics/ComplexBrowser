#' Run the ComplexBrowser command-line interface
#'
#' Run QC or complex analysis from the command line.
#'
#' Use `qc` for quality control output and `complex` for the full complex
#' analysis workflow. The command reads a CSV input file, writes the workflow
#' outputs to the requested directory, and returns a status code instead of
#' launching Shiny.
#'
#' @param args Command-line arguments. Defaults to `commandArgs(TRUE)`.
#'
#' @return An integer status code, invisibly: 0 for success, 2 for usage
#'   errors, and 1 for unexpected runtime errors.
#'
#' @examples
#' \dontrun{
#' complexbrowser_cli(c(
#'   "qc",
#'   "--input", "myo.csv",
#'   "--outdir", "out",
#'   "--conditions", "4",
#'   "--replicates", "2"
#' ))
#' }
#'
#' @export
complexbrowser_cli <- function(args = commandArgs(trailingOnly = TRUE)) {
  tryCatch(
    {
      dispatch_cli(args)
      invisible(0L)
    },
    complexbrowser_cli_usage_error = function(error) {
      cli_message("Error: ", conditionMessage(error))
      cli_message(cli_usage())
      invisible(2L)
    },
    error = function(error) {
      cli_message("Error: ", conditionMessage(error))
      invisible(1L)
    }
  )
}

dispatch_cli <- function(args) {
  if (length(args) == 0L || args[[1]] %in% c("-h", "--help")) {
    stop_cli_usage("Missing command.")
  }

  command <- args[[1]]
  options <- parse_cli_options(args[-1])
  if (identical(command, "qc")) {
    return(run_cli_qc(options))
  }
  if (identical(command, "complex")) {
    return(run_cli_complex(options))
  }

  stop_cli_usage("Unsupported command: ", command)
}

run_cli_qc <- function(options) {
  settings <- parse_qc_cli_settings(options)
  qc <- run_cli_qc_workflow(settings)
  write_cli_qc_outputs(qc, settings$outdir)
}

run_cli_complex <- function(options) {
  settings <- parse_complex_cli_settings(options)
  qc <- run_cli_qc_workflow(settings)
  complex <- complexbrowser_run_complex_analysis(
    stats = qc$stats,
    database = settings$database,
    organism = settings$organism,
    no_cond = settings$no_cond,
    no_rep = settings$no_rep,
    database_name = settings$database_name
  )

  write_cli_qc_outputs(qc, settings$outdir)
  write_cli_complex_outputs(complex, settings$outdir)
}

parse_cli_options <- function(args) {
  options <- list()
  index <- 1L
  while (index <= length(args)) {
    item <- args[[index]]
    if (!startsWith(item, "--")) {
      stop_cli_usage("Expected option beginning with --, got: ", item)
    }

    item <- sub("--", "", item)
    if (grepl("=", item, fixed = TRUE)) {
      parts <- strsplit(item, "=", fixed = TRUE)[[1]]
      options[[parts[[1]]]] <- paste(parts[-1], collapse = "=")
      index <- index + 1L
    } else {
      if (index + 1L > length(args) || startsWith(args[[index + 1L]], "--")) {
        stop_cli_usage("Missing value for --", item)
      }
      options[[item]] <- args[[index + 1L]]
      index <- index + 2L
    }
  }
  options
}


parse_qc_cli_settings <- function(options) {
  get_opt <- function(name, default = NULL) {
    val <- options[[name]]
    if (is.null(val)) return(default)
    val
  }
  req <- function(name) {
    val <- get_opt(name)
    if (is.null(val) || !nzchar(val)) stop_cli_usage("Missing required option --", name)
    val
  }
  
  outdir <- req("outdir")
  if (!dir.exists(outdir) && !dir.create(outdir, recursive = TRUE, showWarnings = FALSE)) {
    stop_cli_usage("Could not create output directory: ", outdir)
  }
  input <- req("input")
  if (!file.exists(input)) stop_cli_usage("Input file not found: ", input)
  
  as_pos_int <- function(val, name) {
    parsed <- suppressWarnings(as.integer(val))
    if (is.na(parsed) || parsed < 1L || as.character(parsed) != val) {
      stop_cli_usage("Option --", name, " must be a positive integer.")
    }
    parsed
  }
  
  as_bool <- function(val, name) {
    val <- tolower(val)
    if (val %in% c("true", "t", "1", "yes", "y")) return(TRUE)
    if (val %in% c("false", "f", "0", "no", "n")) return(FALSE)
    stop_cli_usage("Option --", name, " must be true or false.")
  }
  
  list(
    input = input,
    outdir = outdir,
    no_cond = as_pos_int(req("conditions"), "conditions"),
    no_rep = as_pos_int(req("replicates"), "replicates"),
    grouped = as_bool(get_opt("grouped", "false"), "grouped"),
    log2 = as_bool(get_opt("log2", "true"), "log2"),
    q_values = as_bool(get_opt("q-values", "true"), "q-values"),
    normalization = {
      val <- tolower(get_opt("normalization", "none"))
      if (val %in% c("none", "null", "na", "")) NULL
      else {
        allowed <- c("Total Intensity", "Mean", "Median", "Quantile")
        matched <- allowed[tolower(allowed) == val]
        if (length(matched) != 1L) stop_cli_usage("Unsupported normalization method: ", get_opt("normalization", ""))
        matched
      }
    },
    design = {
      val <- get_opt("design", "unpaired")
      if (val %in% c("unpaired", "paired")) val else stop_cli_usage("Unsupported design: ", val)
    },
    statistic = {
      val <- tolower(get_opt("statistic", "polystest"))
      if (val %in% c("polystest", "limma")) val else stop_cli_usage("Unsupported statistic: ", get_opt("statistic", ""))
    }
  )
}

parse_complex_cli_settings <- function(options) {
  settings <- parse_qc_cli_settings(options)
  get_opt <- function(name, default = NULL) {
    val <- options[[name]]
    if (is.null(val)) return(default)
    val
  }
  req <- function(name) {
    val <- get_opt(name)
    if (is.null(val) || !nzchar(val)) stop_cli_usage("Missing required option --", name)
    val
  }
  settings$database <- req("database")
  settings$organism <- req("organism")
  settings$database_name <- get_opt("database-name", settings$database)
  settings
}

run_cli_qc_workflow <- function(settings) {
  input <- utils::read.csv(settings$input, check.names = FALSE)
  suppressWarnings(complexbrowser_run_qc(
    data = input,
    no_cond = settings$no_cond,
    no_rep = settings$no_rep,
    log2 = settings$log2,
    grouped = settings$grouped,
    q_values = settings$q_values,
    normalization = settings$normalization,
    design = settings$design,
    statistic = settings$statistic
  ))
}

write_cli_qc_outputs <- function(qc, outdir) {
  complexbrowser_write_input_statistics(qc$merged_table, file.path(outdir, "input_statistics.csv"))
  saveRDS(qc, file.path(outdir, "qc_result.rds"))
}

write_cli_complex_outputs <- function(complex, outdir) {
  saveRDS(complex, file.path(outdir, "complex_result.rds"))
  if (!is.null(complex$display_table)) {
    complexbrowser_write_complex_table(complex$display_table, file.path(outdir, "complex_table.csv"))
  }
}

stop_cli_usage <- function(...) {
  message <- paste0(...)
  error <- structure(list(message = message), class = c("complexbrowser_cli_usage_error", "error", "condition"))
  stop(error)
}

cli_message <- function(...) {
  cat(paste0(..., "\n"), file = stderr())
}

cli_usage <- function() {
  paste(
    "Usage:",
    "  complexbrowser qc --input FILE --outdir DIR --conditions N --replicates N [--grouped true|false] [--log2 true|false] [--q-values true|false] [--normalization none|Mean|Median|Quantile|Total Intensity] [--design unpaired|paired] [--statistic polystest|limma]",
    "  complexbrowser complex --input FILE --outdir DIR --conditions N --replicates N --database CORUM|\"EBI Complex Portal\"|FILE --organism NAME [QC options]",
    sep = "\n"
  )
}
